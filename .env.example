# ========================
# Sentiment Platform Configuration
# ========================
# Copy this file to .env and fill in values as needed.
# Do NOT commit the .env file.

# Model configuration
MODEL_DIR=models
DEFAULT_MODEL=lstm

# API configuration
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=              # Optional: set to enable API key authentication
API_WORKERS=1

# Streamlit configuration
STREAMLIT_PORT=8501
API_BASE_URL=http://localhost:8000

# Logging
LOG_LEVEL=INFO
